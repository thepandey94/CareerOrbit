# CAREERORBIT ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and replace placeholders with your credentials.

# 1. Managed PostgreSQL Connection Strings (from Neon, Supabase, or local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/careerorbit?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/careerorbit?schema=public"

# 2. Session Encryption Secret (Generate with: openssl rand -hex 32)
# Must be at least 32 characters long
SESSION_SECRET="careerorbit_session_secret_at_least_32_characters_super_secure!"

# 3. Email Delivery Service (Resend API key from https://resend.com)
# When left blank during development, OTPs are logged safely to the terminal console
RESEND_API_KEY=""
EMAIL_FROM="CareerOrbit <onboarding@resend.dev>"

# 4. Google Gemini API Key (from https://aistudio.google.com)
# When omitted, the AI Study Tutor falls back safely to verified curriculum content
GEMINI_API_KEY=""

# 5. Initial Administrator Provisioning Secret
# Used to claim the initial administrator account at /admin/setup
ADMIN_SETUP_SECRET="careerorbit_admin_initial_secret_change_in_production"

# 6. Sandboxed Code Execution Engine (piston | judge0 | mock)
CODE_EXECUTION_ENGINE="piston"
PISTON_API_URL="https://emkc.org/api/v2/piston"
# JUDGE0_API_URL="https://judge0-ce.p.rapidapi.com"
# JUDGE0_API_KEY=""

# 7. Environment Mode
NODE_ENV="development"

